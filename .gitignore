# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.local

# Database & runtime files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db*
data/backups/*
!data/.gitkeep
!data/backups/.gitkeep

# Media uploads (keep directories, ignore uploaded files)
media/videos/*
media/audio/*
!media/videos/.gitkeep
!media/audio/.gitkeep

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db

# Test & coverage output
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Frontend
FRONTEND_PROMPT.md

